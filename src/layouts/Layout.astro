---
import { SEO } from "astro-seo";
import Footer from "@components/footer.astro";
import Navbar from "@components/navbar/navbar.astro";
import { ClientRouter } from "astro:transitions";
import "@fontsource-variable/inter/wght.css";
import "@fontsource-variable/bricolage-grotesque/wght.css";
import bricolageWght from "@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2";
import "../styles/global.css";

export interface Props {
  title?: string;
  lang?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();

const resolvedImageWithDomain = new URL(
  "/opengraph.jpg",
  Astro.site,
).toString();

const { title, lang = "en" } = Astro.props;

const makeTitle = title
  ? title + " | " + "Raka Grarizki"
  : "Raka Grarizki - Software Engineer";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <link rel="dns-prefetch" href="https://images.unsplash.com" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#3E2723" />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href={bricolageWght} />
    <ClientRouter />
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Raka Grarizki Portfolio",
        "url": "https://grarizki.github.io/",
        "author": {
          "@type": "Person",
          "name": "Raka Grarizki",
          "url": "https://grarizki.github.io/",
          "jobTitle": "Software Engineer",
          "worksFor": {
            "@type": "Organization",
            "name": "PT. BFI Finance Indonesia"
          }
        }
      }
    </script>
    <script is:inline>
      const getThemePreference = () => {
        if (
          typeof localStorage !== "undefined" &&
          localStorage.getItem("theme")
        ) {
          return localStorage.getItem("theme");
        }
        if (window.matchMedia("(prefers-color-scheme: light)").matches) {
          return "light";
        }
        return "dark";
      };

      const setDarkClass = (doc = document) => {
        const isDark = getThemePreference() === "dark";
        doc.documentElement.classList[isDark ? "add" : "remove"]("dark");
      };

      // Immediate execution in head before first paint
      setDarkClass();

      // Synchronize theme to incoming document before Astro swaps DOM
      document.addEventListener("astro:before-swap", (event) => {
        setDarkClass(event.newDocument);
      });

      // Re-verify after swap
      document.addEventListener("astro:after-swap", () => {
        setDarkClass();
      });
    </script>

    <SEO
      title={makeTitle}
      description="Raka Grarizki - Software Engineer building high-performance web apps, AI-powered tools, and cross-platform mobile applications. Full-stack across React, FastAPI, NestJS, and Flutter."
      canonical={canonicalURL}
      twitter={{
        creator: "@grarizki",
        site: "@grarizki",
        card: "summary_large_image",
      }}
      openGraph={{
        basic: {
          url: canonicalURL,
          type: "website",
          title: `Raka Grarizki - Software Engineer`,
          image: resolvedImageWithDomain,
        },
        image: {
          alt: "Raka Grarizki - Software Engineer",
        },
      }}
    />
  </head>
  <body
    class="blueprint-grid text-zinc-900 dark:text-zinc-100 transition-colors duration-500 bg-white dark:bg-[#09090B] antialiased selection:bg-emerald-500/20 selection:text-emerald-400 relative min-h-screen">
    <!-- CRT Scanline Atmospheric Overlay -->
    <div class="crt-scanlines fixed inset-0 z-40 pointer-events-none opacity-30 dark:opacity-20" aria-hidden="true"></div>

    <!-- Blueprint Coordinate Badges (Dynamic cursor tracking) -->
    <div
      id="hud-coords"
      class="fixed top-2.5 left-4 z-30 pointer-events-none hidden lg:block font-mono text-[9px] text-zinc-400 dark:text-zinc-600 uppercase tracking-widest"
      aria-hidden="true">
      GRID: 48PX // X: <span id="hud-x" class="text-emerald-600 dark:text-emerald-400 font-semibold tabular-nums">0000</span> Y: <span id="hud-y" class="text-emerald-600 dark:text-emerald-400 font-semibold tabular-nums">0000</span>
    </div>
    <div class="fixed bottom-2 right-4 z-30 pointer-events-none hidden xl:block font-mono text-[9px] text-zinc-400 dark:text-zinc-600 uppercase tracking-widest" aria-hidden="true">
      STATION: BFI_SYS // REFRESH: NOMINAL
    </div>

    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:px-4 focus:py-2 focus:bg-zinc-900 focus:text-white dark:focus:bg-white dark:focus:text-zinc-900 focus:rounded-md focus:outline-none focus:ring-2 focus:ring-emerald-500">
      Skip to content
    </a>
    <Navbar />
    <main id="main-content" class="pt-16 sm:pt-20">
      <div transition:animate="fade">
        <slot />
      </div>
    </main>
    <Footer />
    <style is:global>
      img {
        content-visibility: auto;
      }
    </style>
    <!-- Real-time HUD Cursor Telemetry Script -->
    <script>
      let isTicking = false;
      let mouseX = 0;
      let mouseY = 0;

      function updateHUD() {
        const xElem = document.getElementById("hud-x");
        const yElem = document.getElementById("hud-y");
        if (xElem && yElem) {
          xElem.textContent = mouseX.toString().padStart(4, "0");
          yElem.textContent = mouseY.toString().padStart(4, "0");
        }
        isTicking = false;
      }

      function handleMouseMove(e: MouseEvent) {
        mouseX = Math.round(e.clientX);
        mouseY = Math.round(e.clientY);
        if (!isTicking) {
          requestAnimationFrame(updateHUD);
          isTicking = true;
        }
      }

      function initCursorTracker() {
        window.removeEventListener("mousemove", handleMouseMove);
        window.addEventListener("mousemove", handleMouseMove, { passive: true });
      }

      document.addEventListener("astro:page-load", initCursorTracker);
    </script>
  </body>
</html>
