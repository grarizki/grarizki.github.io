---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import Sectionhead from "@components/sectionhead.astro";
---

<Layout title="About">
  <Container>
    <Sectionhead>
      <Fragment slot="title">About</Fragment>
      <Fragment slot="desc">
        Software Engineer with 3+ years of experience building high-performance web applications, AI-powered tools, and cross-platform mobile apps. I work across the full stack — React, Next.js, and Astro on the frontend; FastAPI, NestJS, and Node.js on the backend; Flutter for mobile.
        <br/>
        <br/>
        Currently at PT. BFI Finance Indonesia, Indonesia's largest multifinance company, where I led performance optimization efforts that achieved 97% LCP improvement and 50-60% reduction in CMS API requests. Beyond frontend, I build agentic AI pipelines, real-time microservices with gRPC and WebSocket, and CLI-first developer tooling.
        <br/>
        <br/>
        My approach combines analytical thinking (Physics Engineering background) with pragmatic engineering. I care about performance, clean architecture, and shipping things that work — whether that's a conversion-optimized marketing site, an LLM-powered product analyzer, or a monorepo that trains models and tracks artifacts.
        <br/>
        <br/>
        Let's connect and build something together.
      </Fragment>
    </Sectionhead>
    <div class="grid md:grid-cols-3 gap-10 mx-auto pl-6 mt-4">
      <div>
        <a
          href="https://www.linkedin.com/in/grarizki"
          target="_blank"
          rel="noopener noreferrer">
          <button
            class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2 px-4 rounded-lg transition">
            LinkedIn
          </button>
        </a>
        <a
          href="mailto:raka.grarizki@gmail.com"
          target="_blank"
          rel="noopener noreferrer">
          <button
            class="bg-gray-600 hover:bg-gray-700 text-white font-semibold py-2 px-4 rounded-lg transition">
            Mail
          </button>
        </a>
        <a
          href="https://github.com/grarizki"
          target="_blank"
          rel="noopener noreferrer">
          <button
            class="bg-gray-800 hover:bg-gray-900 text-white font-semibold py-2 px-4 rounded-lg transition">
            GitHub
          </button>
        </a>
      </div>
    </div>
  </Container>
</Layout>
