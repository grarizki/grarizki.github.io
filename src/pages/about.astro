---
import Layout from "@layouts/Layout.astro";
import Container from "@components/container.astro";
import AboutHero from "@components/about/AboutHero.astro";
import AboutFocus from "@components/about/AboutFocus.astro";
import AboutMethod from "@components/about/AboutMethod.astro";
import AboutEvidence from "@components/about/AboutEvidence.astro";
import AboutKnowledge from "@components/about/AboutKnowledge.astro";
import AboutCta from "@components/about/AboutCta.astro";
import { aboutData } from "../data/about";
---

<Layout title="About">
  <Container class="max-w-5xl">
    <main class="about-page">
      <AboutHero
        eyebrow={aboutData.eyebrow}
        headline={aboutData.headline}
        bio={aboutData.bio}
        proofTags={aboutData.proofTags}
        status={aboutData.status}
      />
      <AboutFocus pillars={aboutData.pillars} />
      <AboutMethod methodology={aboutData.methodology} />
      <AboutEvidence
        experience={aboutData.experience}
        metrics={aboutData.metrics}
      />
      <AboutKnowledge
        contributions={aboutData.contributions}
        principles={aboutData.principles}
      />
      <AboutCta />
    </main>
  </Container>
</Layout>
