---
const projects = [
  {
    name: "StocksX",
    description:
      "Indonesian stock market platform with real-time charts, broker activity tracking, watchlist, and multi-language support.",
    tech: ["Nuxt", "Vue 3", "TypeScript", "Tailwind", "Chart.js", "Firebase"],
    github: "https://github.com/grarizki/stocksX",
    live: "https://stoxlyz.com",
    featured: true,
  },
  {
    name: "Stormlax",
    description:
      "Real-time analytics microservice with gRPC inter-service communication, WebSocket notifications, and JWT authentication.",
    tech: ["NestJS", "gRPC", "Astro", "React 19", "Socket.IO", "Turborepo"],
    github: "https://github.com/grarizki/Stormlax",
    live: null,
    featured: false,
  },
  {
    name: "AI Engineer Monorepo",
    description:
      "CLI-first monorepo for AI/ML prototyping. FastAPI backend with training pipeline, artifact tracking, and Astro dashboard.",
    tech: ["FastAPI", "Astro", "SQLAlchemy", "Docker", "Typer", "Alembic"],
    github: "https://github.com/grarizki/template-monorepo-ai-engineer",
    live: null,
    featured: false,
  },
  {
    name: "gh-opportunities",
    description:
      "Rust CLI + TUI that scans GitHub repos for beginner-friendly issues, stale PRs, and README gaps, ranking them by impact.",
    tech: ["Rust", "tokio", "ratatui", "axum", "rusqlite"],
    github: "https://github.com/grarizki/foxes-howl",
    live: null,
    featured: false,
  },
  {
    name: "Japan Phrasebook",
    description:
      "Offline-ready Japanese phrasebook PWA for daily life in Japan. Browse phrases by scenario, save favorites, and add custom entries offline.",
    tech: ["React 19", "TypeScript", "Vite", "Tailwind", "localforage", "PWA"],
    github: "https://github.com/grarizki/japan-phrasebook",
    live: "https://grarizki.github.io/japan-phrasebook/",
    featured: false,
  },
  {
    name: "Product Discovery AI",
    description:
      "AI-facilitated product discovery interview that guides users through 10 categories and generates a complete PRD draft.",
    tech: ["FastAPI", "OpenRouter", "Jinja2", "uv"],
    github: "https://github.com/grarizki/assignment-3-devscale",
    live: null,
    featured: false,
  },
];
---

<section id="projects" class="py-24 md:py-36 border-b border-black/[0.06] dark:border-white/[0.08]">
  <header class="max-w-2xl mb-16 space-y-3">
    <span class="inline-flex items-center rounded-full px-3 py-1 font-mono text-[10px] uppercase tracking-[0.2em] font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
      01 / Selected Engineering Projects
    </span>
    <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 mt-2">
      Software engineered for scale and operational utility.
    </h2>
    <p class="text-zinc-600 dark:text-zinc-400 text-sm sm:text-base leading-relaxed">
      A curated collection of full-stack web platforms, distributed microservices, CLI developer tools, and agentic AI systems.
    </p>
  </header>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
    {projects.map((project, i) => (
      <div
        class:list={[
          "p-2 rounded-[2rem] bg-black/[0.02] dark:bg-white/[0.03] border border-black/[0.06] dark:border-white/[0.08] transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:border-emerald-500/30",
          project.featured ? "md:col-span-2" : "",
        ]}>
        <article class="h-full p-6 sm:p-8 rounded-[calc(2rem-0.5rem)] bg-white dark:bg-zinc-950/80 shadow-[inset_0_1px_1px_rgba(255,255,255,0.1)] flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-4">
              <span class="font-mono text-xs font-semibold text-zinc-400 dark:text-zinc-500">
                0{i + 1}
              </span>
              {project.featured && (
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-medium bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                  Featured Project
                </span>
              )}
            </div>

            <h3 class="text-xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
              {project.name}
            </h3>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 mt-2.5 leading-relaxed">
              {project.description}
            </p>

            <div class="flex flex-wrap gap-2 mt-5">
              {project.tech.map((t) => (
                <span class="px-2.5 py-1 text-[11px] font-mono text-zinc-600 dark:text-zinc-400 bg-zinc-100 dark:bg-zinc-900 border border-black/[0.04] dark:border-white/[0.06] rounded-md">
                  {t}
                </span>
              ))}
            </div>
          </div>

          <div class="pt-8 flex flex-wrap items-center gap-3">
            {project.live && (
              <a
                href={project.live}
                target="_blank"
                rel="noopener noreferrer"
                class="group inline-flex items-center gap-2.5 pl-4 pr-1.5 py-1.5 rounded-full bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 text-xs font-mono font-semibold hover:bg-zinc-800 dark:hover:bg-zinc-100 transition-all duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.98]">
                <span>Live demo</span>
                <span class="w-6 h-6 rounded-full bg-white/20 dark:bg-black/10 flex items-center justify-center transition-transform duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 17L17 7"></path>
                    <path d="M7 7h10v10"></path>
                  </svg>
                </span>
              </a>
            )}

            {project.github && (
              <a
                href={project.github}
                target="_blank"
                rel="noopener noreferrer"
                class="group inline-flex items-center gap-2.5 pl-4 pr-1.5 py-1.5 rounded-full border border-black/[0.08] dark:border-white/[0.12] bg-black/[0.02] dark:bg-white/[0.04] text-xs font-mono text-zinc-800 dark:text-zinc-200 hover:border-black/20 dark:hover:border-white/20 transition-all duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.98]">
                <span>Source code</span>
                <span class="w-6 h-6 rounded-full bg-black/5 dark:bg-white/10 flex items-center justify-center transition-transform duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
                  <svg xmlns="http://www.w3.org/2000/svg" width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M7 17L17 7"></path>
                    <path d="M7 7h10v10"></path>
                  </svg>
                </span>
              </a>
            )}
          </div>
        </article>
      </div>
    ))}
  </div>
</section>
