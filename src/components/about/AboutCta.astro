---
---

<section class="py-24 md:py-36">
  <div class="p-2 rounded-[2.5rem] bg-black/[0.02] dark:bg-white/[0.03] border border-black/[0.06] dark:border-white/[0.08]">
    <div class="p-8 sm:p-14 rounded-[calc(2.5rem-0.5rem)] bg-white dark:bg-zinc-950/90 shadow-[inset_0_1px_1px_rgba(255,255,255,0.12)]">
      <div class="max-w-2xl space-y-4">
        <span class="inline-flex items-center rounded-full px-3 py-1 font-mono text-[10px] uppercase tracking-[0.2em] font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
          05 / Start a Conversation
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 mt-2">
          Building a product with complex workflows or architectural pressure?
        </h2>
        <p class="text-zinc-600 dark:text-zinc-400 text-sm sm:text-base leading-relaxed">
          Let's discuss interface boundaries, application performance, and resilient design systems for your engineering team.
        </p>
      </div>

      <nav aria-label="About page actions" class="mt-10 flex flex-wrap gap-4 items-center">
        <!-- Button-in-Button Primary Action -->
        <a
          href="/contact"
          class="group inline-flex items-center gap-3 pl-6 pr-2 py-2 rounded-full bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 text-xs font-mono font-semibold hover:bg-zinc-800 dark:hover:bg-zinc-100 transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.98] shadow-sm">
          <span>Get in touch</span>
          <span class="w-8 h-8 rounded-full bg-white/20 dark:bg-black/10 flex items-center justify-center transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 17L17 7"></path>
              <path d="M7 7h10v10"></path>
            </svg>
          </span>
        </a>

        <!-- Button-in-Button Secondary Action: Work -->
        <a
          href="/work"
          class="group inline-flex items-center gap-3 pl-5 pr-2 py-2 rounded-full border border-black/[0.08] dark:border-white/[0.12] bg-black/[0.02] dark:bg-white/[0.04] text-xs font-mono text-zinc-800 dark:text-zinc-200 hover:border-black/20 dark:hover:border-white/20 transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.98]">
          <span>View selected work</span>
          <span class="w-7 h-7 rounded-full bg-black/5 dark:bg-white/10 flex items-center justify-center transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 17L17 7"></path>
              <path d="M7 7h10v10"></path>
            </svg>
          </span>
        </a>

        <!-- Button-in-Button Secondary Action: Writing -->
        <a
          href="/blog"
          class="group inline-flex items-center gap-3 pl-5 pr-2 py-2 rounded-full border border-black/[0.08] dark:border-white/[0.12] bg-black/[0.02] dark:bg-white/[0.04] text-xs font-mono text-zinc-800 dark:text-zinc-200 hover:border-black/20 dark:hover:border-white/20 transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.98]">
          <span>Read technical writing</span>
          <span class="w-7 h-7 rounded-full bg-black/5 dark:bg-white/10 flex items-center justify-center transition-transform duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
            <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 17L17 7"></path>
              <path d="M7 7h10v10"></path>
            </svg>
          </span>
        </a>
      </nav>
    </div>
  </div>
</section>
