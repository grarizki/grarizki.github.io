---
import type { MethodStep } from "../../data/about";

interface Props {
  methodology: MethodStep[];
}

const { methodology } = Astro.props;
---

<section class="py-24 md:py-36 border-b border-black/[0.06] dark:border-white/[0.08]">
  <header class="max-w-2xl mb-16 space-y-3">
    <span class="inline-flex items-center rounded-full px-3 py-1 font-mono text-[10px] uppercase tracking-[0.2em] font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
      02 / Working Model
    </span>
    <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 mt-2">
      From ambiguity to a defensible decision.
    </h2>
    <p class="text-zinc-600 dark:text-zinc-400 text-sm sm:text-base leading-relaxed">
      Architecture starts with the guarantee a product requires, not with a preferred library or an abstract diagram.
    </p>
  </header>

  <div class="grid sm:grid-cols-2 lg:grid-cols-5 gap-4">
    {methodology.map((step) => (
      <div class="p-1.5 rounded-[1.75rem] bg-black/[0.02] dark:bg-white/[0.03] border border-black/[0.06] dark:border-white/[0.08] transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:border-emerald-500/20">
        <article class="h-full p-5 sm:p-6 rounded-[calc(1.75rem-0.375rem)] bg-white dark:bg-zinc-950/80 shadow-[inset_0_1px_1px_rgba(255,255,255,0.1)] flex flex-col justify-between">
          <span class="font-mono text-xs font-semibold text-emerald-600 dark:text-emerald-400">
            {step.index}
          </span>
          <div class="mt-8">
            <h3 class="text-base font-bold text-zinc-900 dark:text-zinc-100 tracking-tight">
              {step.title}
            </h3>
            <p class="text-xs text-zinc-500 dark:text-zinc-400 mt-2 leading-relaxed">
              {step.question}
            </p>
          </div>
        </article>
      </div>
    ))}
  </div>
</section>
