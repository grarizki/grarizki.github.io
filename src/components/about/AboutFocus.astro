---
import type { FocusPillar } from "../../data/about";

interface Props {
  pillars: FocusPillar[];
}

const { pillars } = Astro.props;
---

<section class="py-24 md:py-36 border-b border-black/[0.06] dark:border-white/[0.08]">
  <header class="max-w-2xl mb-16 space-y-3">
    <span class="inline-flex items-center rounded-full px-3 py-1 font-mono text-[10px] uppercase tracking-[0.2em] font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
      01 / Focus Areas
    </span>
    <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 mt-2">
      Product pressure becomes an engineering shape.
    </h2>
    <p class="text-zinc-600 dark:text-zinc-400 text-sm sm:text-base leading-relaxed">
      Core competencies focus on user workflows, interface boundaries, type safety, and resilient platforms.
    </p>
  </header>

  <div class="grid md:grid-cols-3 gap-6">
    {pillars.map((pillar) => (
      <div class="group p-2 rounded-[2rem] bg-black/[0.02] dark:bg-white/[0.03] border border-black/[0.06] dark:border-white/[0.08] transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:border-emerald-500/30">
        <article class="h-full p-6 sm:p-8 rounded-[calc(2rem-0.5rem)] bg-white dark:bg-zinc-950/80 shadow-[inset_0_1px_1px_rgba(255,255,255,0.12)] flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between">
              <div class="w-11 h-11 rounded-2xl bg-zinc-100 dark:bg-zinc-900 border border-black/[0.04] dark:border-white/[0.06] flex items-center justify-center text-zinc-800 dark:text-zinc-200">
                {pillar.iconName === "workflow" && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect width="8" height="8" x="3" y="3" rx="2"></rect>
                    <path d="M7 11v4a2 2 0 0 0 2 2h4"></path>
                    <rect width="8" height="8" x="13" y="13" rx="2"></rect>
                  </svg>
                )}
                {pillar.iconName === "blocks" && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M10 22V7a1 1 0 0 0-1-1H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5a1 1 0 0 0-1-1H2"></path>
                    <rect width="8" height="8" x="14" y="2" rx="1"></rect>
                  </svg>
                )}
                {pillar.iconName === "gauge" && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m12 14 4-4"></path>
                    <path d="M3.34 19a10 10 0 1 1 17.32 0"></path>
                  </svg>
                )}
              </div>
              <span class="font-mono text-xs font-semibold text-zinc-400 dark:text-zinc-500">
                {pillar.index}
              </span>
            </div>

            <h3 class="text-lg font-bold text-zinc-900 dark:text-zinc-100 mt-6 tracking-tight">
              {pillar.title}
            </h3>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 mt-2.5 leading-relaxed">
              {pillar.description}
            </p>
          </div>
        </article>
      </div>
    ))}
  </div>
</section>
