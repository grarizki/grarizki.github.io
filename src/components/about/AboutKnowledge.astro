---
import type { ContributionItem } from "../../data/about";

interface Props {
  contributions: ContributionItem[];
  principles: string[];
}

const { contributions, principles } = Astro.props;
---

<section class="py-24 md:py-36 border-b border-black/[0.06] dark:border-white/[0.08]">
  <header class="max-w-2xl mb-16 space-y-3">
    <span class="inline-flex items-center rounded-full px-3 py-1 font-mono text-[10px] uppercase tracking-[0.2em] font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
      04 / Engineering Knowledge
    </span>
    <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100 mt-2">
      The work becomes more valuable when the reasoning travels.
    </h2>
    <p class="text-zinc-600 dark:text-zinc-400 text-sm sm:text-base leading-relaxed">
      Practical engineering lessons and operating principles establish consistency across frontend codebases.
    </p>
  </header>

  <div class="grid md:grid-cols-3 gap-6">
    {contributions.map((item) => (
      <div class="p-1.5 rounded-[2rem] bg-black/[0.02] dark:bg-white/[0.03] border border-black/[0.06] dark:border-white/[0.08] transition-all duration-500 ease-[cubic-bezier(0.32,0.72,0,1)] hover:border-emerald-500/20">
        <article class="h-full p-6 sm:p-8 rounded-[calc(2rem-0.375rem)] bg-white dark:bg-zinc-950/80 shadow-[inset_0_1px_1px_rgba(255,255,255,0.1)] flex flex-col justify-between">
          <div>
            <div class="w-11 h-11 rounded-2xl bg-zinc-100 dark:bg-zinc-900 border border-black/[0.04] dark:border-white/[0.06] flex items-center justify-center text-zinc-800 dark:text-zinc-200">
              {item.type === "speaking" && (
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                </svg>
              )}
              {item.type === "mentoring" && (
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 10v6M2 10l10-5 10 5-10 5z"></path>
                  <path d="M6 12v5c3 3 9 3 12 0v-5"></path>
                </svg>
              )}
            </div>

            <span class="block font-mono text-[10px] uppercase tracking-[0.2em] text-zinc-400 dark:text-zinc-500 mt-6 font-semibold">
              {item.type}
            </span>
            <h3 class="text-lg font-bold text-zinc-900 dark:text-zinc-100 mt-1 tracking-tight">
              {item.title}
            </h3>
            <p class="text-xs sm:text-sm text-zinc-600 dark:text-zinc-400 mt-2.5 leading-relaxed">
              {item.description}
            </p>
          </div>
        </article>
      </div>
    ))}

    <div class="p-1.5 rounded-[2rem] bg-black/[0.02] dark:bg-white/[0.03] border border-black/[0.06] dark:border-white/[0.08]">
      <article class="h-full p-6 sm:p-8 rounded-[calc(2rem-0.375rem)] bg-white dark:bg-zinc-950/80 shadow-[inset_0_1px_1px_rgba(255,255,255,0.1)]">
        <div class="w-11 h-11 rounded-2xl bg-zinc-100 dark:bg-zinc-900 border border-black/[0.04] dark:border-white/[0.06] flex items-center justify-center text-zinc-800 dark:text-zinc-200">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path>
            <path d="M6 6h10"></path>
            <path d="M6 10h10"></path>
          </svg>
        </div>

        <span class="block font-mono text-[10px] uppercase tracking-[0.2em] text-zinc-400 dark:text-zinc-500 mt-6 font-semibold">
          Discipline
        </span>
        <h3 class="text-lg font-bold text-zinc-900 dark:text-zinc-100 mt-1 tracking-tight">
          Operating Principles
        </h3>
        <ul class="mt-4 space-y-2.5 text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
          {principles.map((principle) => (
            <li class="flex items-start gap-2.5">
              <span class="text-emerald-500 mt-0.5 text-sm leading-none">•</span>
              <span>{principle}</span>
            </li>
          ))}
        </ul>
      </article>
    </div>
  </div>
</section>
