---
// @ts-ignore
import { Icon } from "astro-icon/components";
---

<div class="mt-24">
  <h2 class="text-center text-slate-900 dark:text-slate-200">
    Tech Stack
  </h2>
  <div class="flex gap-8 md:gap-16 items-center justify-center my-10 flex-wrap">
    <a href="https://www.python.org/" target="_blank" aria-label="Python">
      <Icon class="size-8 md:size-12" name="simple-icons:python" />
    </a>
    <a href="https://nextjs.org/" target="_blank" aria-label="Next.js">
      <Icon class="size-8 md:size-12" name="simple-icons:nextdotjs" />
    </a>
    <a href="https://astro.build/" target="_blank" aria-label="Astro">
      <Icon class="size-8 md:size-12" name="simple-icons:astro" />
    </a>
    <a href="https://react.dev/" target="_blank" aria-label="React">
      <Icon class="size-8 md:size-12" name="simple-icons:react" />
    </a>
    <a href="https://www.typescriptlang.org/" target="_blank" aria-label="TypeScript">
      <Icon class="size-8 md:size-12" name="simple-icons:typescript" />
    </a>
    <a href="https://fastapi.tiangolo.com/" target="_blank" aria-label="FastAPI">
      <Icon class="size-8 md:size-12" name="simple-icons:fastapi" />
    </a>
    <a href="https://tailwindcss.com/" target="_blank" aria-label="Tailwind CSS">
      <Icon class="size-8 md:size-12" name="simple-icons:tailwindcss" />
    </a>
    <a href="https://github.com/grarizki" target="_blank" aria-label="GitHub">
      <Icon class="size-8 md:size-12" name="simple-icons:github" />
    </a>
  </div>
</div>
