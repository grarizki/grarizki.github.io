---
---

<form
  action="https://api.web3forms.com/submit"
  method="POST"
  id="form"
  class="needs-validation space-y-5"
  novalidate>
  <input type="hidden" name="access_key" value="YOUR_ACCESS_KEY_HERE" />
  <input type="checkbox" class="hidden" style="display:none" name="botcheck" />

  <!-- Name Input -->
  <div class="space-y-1.5">
    <label for="name" class="block font-mono text-xs uppercase tracking-wider text-zinc-600 dark:text-zinc-400 font-semibold">
      Sender Name // ID
    </label>
    <input
      type="text"
      name="name"
      id="name"
      placeholder="e.g. John Carmack"
      required
      class="w-full px-4 py-3 rounded-xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-sm font-mono text-zinc-900 dark:text-zinc-100 placeholder:text-zinc-400 dark:placeholder:text-zinc-600 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-colors outline-none"
    />
    <div class="empty-feedback invalid-feedback text-red-500 text-xs font-mono mt-1 hidden">
      Name parameter required.
    </div>
  </div>

  <!-- Email Input -->
  <div class="space-y-1.5">
    <label for="email" class="block font-mono text-xs uppercase tracking-wider text-zinc-600 dark:text-zinc-400 font-semibold">
      Return Address // RFC 5322
    </label>
    <input
      type="email"
      name="email"
      id="email"
      placeholder="e.g. engineer@platform.dev"
      required
      class="w-full px-4 py-3 rounded-xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-sm font-mono text-zinc-900 dark:text-zinc-100 placeholder:text-zinc-400 dark:placeholder:text-zinc-600 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-colors outline-none"
    />
    <div class="empty-feedback text-red-500 text-xs font-mono mt-1 hidden">
      Valid email address required.
    </div>
  </div>

  <!-- Message Input -->
  <div class="space-y-1.5">
    <label for="message" class="block font-mono text-xs uppercase tracking-wider text-zinc-600 dark:text-zinc-400 font-semibold">
      Message Payload // TEXT
    </label>
    <textarea
      name="message"
      id="message"
      rows="4"
      placeholder="Discuss an architecture challenge or engineering opportunity..."
      required
      class="w-full px-4 py-3 rounded-xl bg-zinc-50 dark:bg-zinc-900 border border-zinc-200 dark:border-zinc-800 text-sm font-mono text-zinc-900 dark:text-zinc-100 placeholder:text-zinc-400 dark:placeholder:text-zinc-600 focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 transition-colors outline-none resize-none"
    ></textarea>
    <div class="empty-feedback invalid-feedback text-red-500 text-xs font-mono mt-1 hidden">
      Payload cannot be empty.
    </div>
  </div>

  <!-- Submit Button with Button-in-Button Architecture -->
  <div class="pt-2">
    <button
      type="submit"
      class="group w-full inline-flex items-center justify-between pl-6 pr-2 py-2 rounded-full bg-zinc-900 dark:bg-white text-white dark:text-zinc-900 text-xs font-mono font-semibold hover:bg-zinc-800 dark:hover:bg-zinc-100 transition-all duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] active:scale-[0.98] shadow-sm">
      <span>Transmit Dispatch</span>
      <span class="w-8 h-8 rounded-full bg-white/20 dark:bg-black/10 flex items-center justify-center transition-transform duration-300 ease-[cubic-bezier(0.32,0.72,0,1)] group-hover:translate-x-0.5 group-hover:-translate-y-0.5">
        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M7 17L17 7"></path>
          <path d="M7 7h10v10"></path>
        </svg>
      </span>
    </button>
  </div>

  <div id="result" class="font-mono text-xs text-center pt-2"></div>
</form>

<script is:inline>
  const form = document.getElementById('form');
  const result = document.getElementById('result');

  form?.addEventListener('submit', function (e) {
    e.preventDefault();
    if (!form.checkValidity()) {
      form.querySelectorAll(':invalid')[0].focus();
      return;
    }
    const formData = new FormData(form);
    const object = Object.fromEntries(formData);
    const json = JSON.stringify(object);

    result.innerHTML = '<span class="text-zinc-500">Transmitting packet...</span>';

    fetch('https://api.web3forms.com/submit', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        Accept: 'application/json',
      },
      body: json,
    })
      .then(async (response) => {
        let json = await response.json();
        if (response.status == 200) {
          result.innerHTML = '<span class="text-emerald-500 font-bold">[DISPATCH_SUCCESS] Message received.</span>';
        } else {
          result.innerHTML = '<span class="text-red-500 font-bold">[DISPATCH_FAILED] ' + json.message + '</span>';
        }
      })
      .catch((error) => {
        result.innerHTML = '<span class="text-red-500 font-bold">[NETWORK_ERROR] Message transmit failed.</span>';
      })
      .then(function () {
        form.reset();
        setTimeout(() => {
          result.innerHTML = '';
        }, 5000);
      });
  });
</script>
