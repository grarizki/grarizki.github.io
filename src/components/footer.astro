---
import Container from "./container.astro";

const year = new Date().getFullYear();
---

<footer class="py-16 border-t border-black/[0.08] dark:border-white/[0.1]" role="contentinfo">
  <Container>
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-zinc-600 dark:text-zinc-400">
      <span>© {year} Raka Grarizki</span>
      <span class="text-center sm:text-right font-medium tracking-wide text-zinc-700 dark:text-zinc-300">
        DISCIPLINE: FIRST_PRINCIPLES // CORE: DISTRIBUTED_SYS
      </span>
    </div>
  </Container>
</footer>
