---
import { LuminousTopography } from "@components/ui/luminous-topography";
const { align = "center" } = Astro.props;

// Static SSR — deterministic particle field, no runtime entropy
const particles = [
  { top: "16%", left: "10%", size: 4, delay: 0, dur: 6 },
  { top: "30%", left: "22%", size: 3, delay: 1.2, dur: 7 },
  { top: "12%", left: "38%", size: 5, delay: 2.1, dur: 5.5 },
  { top: "68%", left: "14%", size: 3, delay: 0.6, dur: 8 },
  { top: "80%", left: "28%", size: 4, delay: 3, dur: 6.5 },
  { top: "22%", left: "62%", size: 3, delay: 1.8, dur: 7.5 },
  { top: "74%", left: "48%", size: 5, delay: 0.9, dur: 6 },
  { top: "16%", left: "84%", size: 3, delay: 2.6, dur: 7 },
  { top: "60%", left: "78%", size: 4, delay: 1.4, dur: 8.5 },
  { top: "86%", left: "88%", size: 3, delay: 3.4, dur: 6 },
  { top: "42%", left: "90%", size: 4, delay: 0.3, dur: 7.5 },
];

// Rainbow sweep palette (same hues as ruixen hero)
const rainbow = {
  "--color-1": "hsl(210, 100%, 60%)", // Blue
  "--color-2": "hsl(280, 80%, 65%)",  // Purple
  "--color-3": "hsl(330, 100%, 65%)", // Pink
  "--color-4": "hsl(20, 100%, 60%)",  // Orange
  "--color-5": "hsl(140, 70%, 50%)",  // Green
};
---

<div
  class:list={[
    "relative isolate w-full overflow-hidden rounded-2xl mt-16",
    align === "center" && "text-center",
  ]}>
  <LuminousTopography
    client:load
    class="absolute inset-0"
    density={16}
    depth={0.9}
    drift={0.7}
    intensity={1}
    interactive
    safeArea={{ x: 0.08, y: 0.25, w: 0.84, h: 0.5 }}
  />

  <!-- gradient blobs -->
  <div
    class="pointer-events-none absolute -top-24 -left-24 z-0 h-72 w-72 rounded-full blur-[120px]"
    style="background: color-mix(in srgb, var(--motiq-accent) 28%, transparent)" />
  <div
    class="pointer-events-none absolute -bottom-28 -right-24 z-0 h-96 w-96 rounded-full blur-[160px]"
    style="background: color-mix(in srgb, var(--motiq-accent) 18%, transparent)" />

  <!-- floating particles -->
  {particles.map((p) => (
    <span
      class="particle pointer-events-none absolute z-0 rounded-full bg-[var(--motiq-fg)]"
      style={`top:${p.top};left:${p.left};width:${p.size}px;height:${p.size}px;opacity:.2;animation:float ${p.dur}s ease-in-out ${p.delay}s infinite`}
    />
  ))}

  <div
    class="relative z-10 flex min-h-[420px] flex-col items-center justify-center gap-6 px-8 text-center">
    <span
      style={rainbow}
      class="rainbow-border rounded-full bg-[linear-gradient(90deg,var(--color-1),var(--color-2),var(--color-3),var(--color-4),var(--color-5))] bg-[length:200%] p-px shadow-sm animate-[rainbow_6s_linear_infinite]">
      <span
        class="animate-fade-up block rounded-full bg-[var(--motiq-surface)] px-3.5 py-1 text-[11px] font-medium uppercase tracking-[0.16em] text-[var(--motiq-muted)]">
        <slot name="badge">Backgrounds</slot>
      </span>
    </span>
    <h1
      class="animate-fade-up max-w-3xl text-4xl font-semibold tracking-tight text-[var(--motiq-fg)] md:text-6xl"
      style="animation-delay:.1s">
      <slot name="title">Title</slot>
    </h1>
    <div
      class="animate-fade-up max-w-xl text-sm text-[var(--motiq-fg-secondary)] md:text-base"
      style="animation-delay:.2s">
      <slot name="desc" />
    </div>
    <div
      class="animate-fade-up mt-2 flex flex-wrap items-center justify-center gap-4"
      style="animation-delay:.3s">
      <slot name="cta" />
    </div>
  </div>
</div>
